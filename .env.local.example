# Copie para .env.local ou use npm run setup:local para gerar valores seguros locais.
VITE_API_BASE_URL=/api
NEXUS_BACKEND_DIR=../Nexus
NEXUS_DB_URL=jdbc:mysql://127.0.0.1:3306/banco_teste?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
NEXUS_DB_USERNAME=nexus_local
NEXUS_DB_PASSWORD=defina-uma-senha-local
NEXUS_JWT_SECRET=defina-um-segredo-local
NEXUS_ADMIN_LOGIN=admin-local
NEXUS_ADMIN_PASSWORD=defina-uma-senha-local
